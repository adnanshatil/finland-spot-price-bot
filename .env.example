# Telegram Bot Configuration
# Copy this file to .env and replace the placeholders with your actual credentials:
#   cp .env.example .env
#   chmod 600 .env

# HTTP API token provided by @BotFather (e.g. 123456789:ABCdefGHIjklMNOpqrSTUvwxYZ)
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Numeric chat ID from @userinfobot (e.g. 123456789)
TELEGRAM_CHAT_ID=YOUR_CHAT_ID_HERE
